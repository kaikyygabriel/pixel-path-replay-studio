# TriboPay — configure somente como Secrets no ambiente do servidor/Lovable.
# Nunca use prefixo VITE_ e nunca publique valores reais neste arquivo.
TRIBOPAY_API_TOKEN=
# Hash de uma oferta JÁ EXISTENTE vinculada ao produto-mãe hnz0ihobyy.
# A API retorna HTTP 422 quando offer_hash não é enviado.
TRIBOPAY_OFFER_HASH=
